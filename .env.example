# VentusGPT v2.0 environment configuration
# Never commit real secrets.

# Required for Gemini conversational and multimodal capabilities
GEMINI_API_KEY=

# Optional official India Meteorological Department integration.
# When configured, official warnings are kept separate from NWP model signals.
IMD_API_KEY=
IMD_API_BASE_URL=https://api.imd.gov.in/public

# Optional per-product overrides if your IMD access uses custom endpoints.
# IMD_DISTRICT_WARNING_URL=
# IMD_NOWCAST_URL=
# IMD_RAINFALL_URL=
# IMD_AGROMET_URL=

# Optional server port
PORT=3000
